{
  "story_id": "Prologue",
  "title": "国土安全",
  "desc": "第一章剧情",
  "segments": [
    {
      "segment_id": "SEGMENT_01_WAKE_UP",
      "title": "苏醒",
      "remark": "开场动画 + 对话 + 接任务",
      "nodes": [
        {
          "type": "PlayFilm",
          "body": {
            "film_id": "hello"
          }
        },
        {
          "type": "GiveQuest",
          "body": {
            "quest_id": "MAIN_01_TALK_MARY",
            "title": "初来小镇",
            "steps": [
              {
                "id": "dialog",
                "desc": "去和 Mary对话吧",
                "type": "TalkToNPC",
                "required_count": 1,
                "target_id": "Mary"
              }
            ]
          }
        },
        {
          "type": "Dialogue",
          "body": {
            "dialogue_id": "FarmerIntro",
            "npc": "Mary",
            "lines": [
              "你醒了。",
              "别乱动，你刚被拖回来的。",
              "如果再晚一点，你就死在外面了。",
              "这里不是安全区，但比外面好一点。",
              "你叫什么名字已经不重要了。",
              "能站起来才重要。",
              "这个世界不会等你准备好。",
              "你要学会适应。",
              "你站得住，说明你还没完全废掉。",
              "但你现在的问题不是伤。",
              "是饿。",
              "饿会让人犯错。",
              "犯错的人活不久。",
              "这些土地还能用。",
              "别嫌脏。",
              "只要能长出东西，就是好土地。",
              "种子不多。",
              "别浪费。"
            ]
          }
        },
        {
          "type": "GiveQuest",
          "body": {
            "quest_id": "MAIN_02_FOOD",
            "title": "我需要食物",
            "grants": [
              { "item_id": 4, "count": 1 },
              { "item_id": 8, "count": 1 },
              { "item_id": 21, "count": 5 }
            ],
            "steps": [
              {
                "id": "plant_carrot",
                "desc": "种植 5 个南瓜",
                "type": "PlantCrop",
                "required_count": 5,
                "target_id": 21
              },
              {
                "id": "harvest_carrot",
                "desc": "收获 5 个南瓜",
                "type": "HarvestCrop",
                "required_count": 5,
                "target_id": 33
              }
            ]
          }
        },
        {
          "type": "GiveQuest",
          "body": {
            "quest_id": "MAIN_03_FOOD",
            "title": "交付任务",
            "steps": [
              {
                "id": "plant_carrot",
                "desc": "找玛丽交付任务",
                "type": "TalkToNPC",
                "required_count": 1,
                "target_id": "Mary"
              }
            ]
          }
        },
        {
          "type": "Dialogue",
          "body": {
            "dialogue_id": "FarmerIntro",
            "npc": "Mary",
            "lines": [
              "不错。",
              "至少你学会了一件事。",
              "粮食不会自己出现。",
              "活下去要靠双手。",
              "但光靠吃，是不够的。"
            ]
          }
        }
      ],
      "next_segment": "SEGMENT_02_TOOL",
      "onComplete": {
      }
    },

    {
      "segment_id": "SEGMENT_03_DANGER",
      "title": "任务后的剧情段",
      "nodes": [
        {
          "type": "GiveQuest",
          "body": {
            "quest_id": "MAIN_03_TALK_RODE",
            "title": "危机四伏",
            "steps": [
              {
                "id": "dialog",
                "desc": "找Rode对话",
                "type": "TalkToNPC",
                "required_count": 1,
                "target_id": "Rode"
              }
            ]
          }
        },
        {
          "type": "Dialogue",
          "body": {
            "npc": "Rode",
            "lines": [
              "站住。",
              "我没见过你。",
              "现在谁都可能是累赘。",
              "外面有怪物。",
              "不是传说。",
              "是每天都会死人的东西。",
              "你要学会对付它们。",
              "不然你会害死别人。",
              "也害死自己。",
              "选择吧。"
            ]
          }
        },
        {
          "type": "GiveQuest",
          "body": {
            "quest_id": "MAIN_04_DANGER",
            "grants": [
              { "item_id": 200, "count": 1 },
              { "item_id": 201, "count": 30 }
            ],
            "title": "危机四伏",
            "steps": [
              {
                "id": "kill_monster",
                "desc": "击杀 3 个游荡怪物",
                "type": "KillMonster",
                "required_count": 1,
                "target_id": 1
              }
            ]
          }
        },
        {
          "type": "GiveQuest",
          "body": {
            "quest_id": "MAIN_03_TALK_RODE_2",
            "title": "交付任务",
            "steps": [
              {
                "id": "dialog",
                "desc": "找Rode对话",
                "type": "TalkToNPC",
                "required_count": 1,
                "target_id": "Rode"
              }
            ]
          }
        },
        {
          "type": "Dialogue",
          "body": {
            "npc": "Rode",
            "lines": [
              "你还站着。",
              "说明你不是废物。",
              "但别高兴太早。",
              "真正的麻烦还没来。"
            ]
          }
        }
      ],
      "next_segment": "SEGMENT_04_BUNKER",
      "onComplete": {
        "next_segment": "SEGMENT_04_BUNKER"
      }
    },
    {
      "segment_id": "SEGMENT_04_BUNKER",
      "title": "任务后的剧情段",
      "nodes": [
        {
          "type": "GiveQuest",
          "body": {
            "quest_id": "MAIN_04_TALK_VIC",
            "title": "初来小镇",
            "steps": [
              {
                "id": "dialog",
                "desc": "找Vic对话",
                "type": "TalkToNPC",
                "required_count": 1,
                "target_id": "Vic"
              }
            ]
          }
        },
        {
          "type": "Dialogue",
          "body": {
            "npc": "Vic",
            "lines": [
              "你终于来了。",
              "我一直在等。",
              "不是等你。",
              "是等一个还能选择的人。",
              "这里保存着过去。",
              "也埋着错误。",
              "世界不是突然毁掉的。",
              "是一步一步走到今天的。",
              "你会看到。",
              "然后你要决定。"
            ]
          }
        },
        {
          "type": "GiveQuest",
          "body": {
            "quest_id": "MAIN_06_BUNKER",
            "steps": [
              {
                "id": "activate_device",
                "desc": "启动旧设备",
                "type": "InteractBuilding",
                "required_count": 1,
                "target_id": "OldTerminal"
              }
            ]
          }
        }
      ],
      "onComplete": {
        "next_segment": "SEGMENT_05_END"
      }
    },
    {
      "segment_id": "SEGMENT_05_END",
      "title": "任务后的剧情段",
      "nodes": [
        {
          "type": "GiveQuest",
          "body": {
            "quest_id": "MAIN_05_TALK_VIC",
            "title": "初来小镇",
            "steps": [
              {
                "id": "dialog",
                "desc": "找Vic对话",
                "type": "TalkToNPC",
                "required_count": 1,
                "target_id": "Vic"
              }
            ]
          }
        },
        {
          "type": "Dialogue",
          "body": {
            "npc": "Vic",
            "lines": [
              "你已经看到了。",
              "这不是灾难。",
              "是选择的结果。",
              "现在轮到你了。",
              "你可以留下。",
              "也可以离开。",
              "世界不会阻止你。",
              "它只会考验你。"
            ]
          }
        }
      ],
      "onComplete": {
        "next_segment": "SEGMENT_07_CurtainCall"
      }
    }

  ]
